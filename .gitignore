# Build output
bin/
obj/
.vs/
*.user
*.suo

# Release packaging
dist/
*.zip

# Runtime logs written beside the add-in
*.log

# Spike scratch
out/

# Corpus models are large and proprietary; CORPUS.md describes how to rebuild
corpus/*.sldprt
corpus/*.SLDPRT
corpus/*.sldasm
corpus/*.SLDASM

# Ad-hoc STEP exports made while testing against the corpus. The STEP files
# that are evidence live in evidence/ and are tracked; these are throwaway.
corpus/*.step
corpus/*.STEP

# Evidence: keep the small analysis artifacts, keep STEP/glTF probes too (they
# are the citations FINDINGS.md rests on and are only a few hundred KB).
# Large native exports from real assemblies do not belong in git:
evidence/**/C6_*.step
evidence/**/*.stp

# Python
__pycache__/
*.pyc

# Local Claude settings
.claude/settings.local.json
