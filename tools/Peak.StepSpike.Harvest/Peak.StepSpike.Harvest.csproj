<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway spike harness for the NEXT-STEP-SW feasibility study. Drives
    SolidWorks over COM automation from OUTSIDE the process: every appearance
    API the study needs is plain automation on ISldWorks, none is addin-only,
    so no COM registration or ISwAddin is involved.

    Because this is a standalone exe and never loads ISwAddin, the strong-name
    binding hazard documented in Peak.Release.csproj does not apply: the
    Private=True copies beside the exe are sufficient and no AssemblyResolve
    hook is needed.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <!-- SLDWORKS.exe is 64-bit; an automation client marshalling to it should
         match to avoid surprises with any in-proc handlers. -->
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>Peak.StepSpike.Harvest</AssemblyName>
    <RootNamespace>Peak.StepSpike.Harvest</RootNamespace>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Builds without the .NET Framework 4.8 developer pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      SW2022 interops deliberately: they are the oldest installed, so they bind
      against every version on this machine (2022/2024/2025/2026). One
      consequence, handled in code: swStepExportAppearances (787) exists only
      from SW2024's swconst, so it is used as a raw preference id rather than a
      symbol. See SwSession.StepPrefs.
    -->
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>C:\Program Files\SOLIDWORKS 2022\SOLIDWORKS\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>C:\Program Files\SOLIDWORKS 2022\SOLIDWORKS\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>C:\Program Files\SOLIDWORKS 2022\SOLIDWORKS\api\redist\SolidWorks.Interop.swpublished.dll</HintPath>
      <Private>True</Private>
      <SpecificVersion>False</SpecificVersion>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
